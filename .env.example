# chatgpt-enterprise-bridge settings
#
# Copy this file to `.env` (same folder) and edit it. `.env` is ignored by git,
# so your API key never gets committed. Lines starting with # are ignored.
# Restart the bridge after changing anything here.

# REQUIRED (recommended): the password your apps send in the `x-api-key` header.
# Make one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# If left empty, a new random key is printed every time the bridge starts.
CHATGPT_BRIDGE_API_KEY=

# --- Optional: remove the # at the start of a line to change a setting ---

# Port the bridge listens on (http://127.0.0.1:<port>).
# CHATGPT_BRIDGE_PORT=4747

# Model to choose in ChatGPT's model picker, by its exact label.
# CHATGPT_MODEL=Latest

# Browser to drive: msedge (default) or chrome.
# CHATGPT_BRIDGE_BROWSER_CHANNEL=msedge

# Set to false to watch the automated browser while it works.
# CHATGPT_HEADLESS=true

# Folder where the saved login is kept (default: .chatgpt-enterprise-bridge in your home folder).
# CHATGPT_BRIDGE_PROFILE_DIR=

# Log detail: debug, info, warn or error.
# LOG_LEVEL=info
